# LudwigOne Environment Configuration

# Database
POSTGRES_DB=ludwigone
POSTGRES_USER=ludwigone
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
DB_HOST=postgres
DB_PORT=5432

# Mistral API
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
RECIPIENT_EMAIL=recipient@example.com

# Ollama (optional)
USE_OLLAMA=false
OLLAMA_URL=http://ollama:11434

# Application Settings
UPLOAD_MAX_SIZE_MB=500
OUTPUT_RETENTION_DAYS=7
MAX_CONCURRENT_VISION_CALLS=5
VISION_API_TIMEOUT_SECONDS=300
VISION_API_MAX_RETRIES=5

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend
VITE_API_URL=http://localhost:8000

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=GENERATE_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=GENERATE_RANDOM_JWT_SECRET_KEY_HERE_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Logging
LOG_LEVEL=INFO
